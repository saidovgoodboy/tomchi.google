[Unit]
Description=Tomchi IP Camera & Bonus Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tomchi
Group=tomchi
SupplementaryGroups=video render dialout
WorkingDirectory=/opt/tomchi
Environment=PYTHONPATH=/opt/tomchi/backend
EnvironmentFile=/opt/tomchi/.env
ExecStart=/bin/sh -c 'exec /opt/tomchi/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
